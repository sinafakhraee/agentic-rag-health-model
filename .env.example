# Copy to .env and fill in. .env is gitignored — never commit real keys.
# Everything the notebook and scripts need is pulled from here.

# ---- Azure context ----
AZURE_TENANT_ID=<your-tenant-guid>
AZURE_SUBSCRIPTION_ID=<your-subscription-guid>
HEALTH_RG=healthmodels
HEALTH_MODEL_NAME=agentic-rag-health

# ---- APIM AI gateway (2 Azure OpenAI backends behind one load-balanced endpoint) ----
APIM_NAME=agrag-gateway
# Client base URL; the notebook POSTs to {base}/responses.
APIM_RESPONSES_BASE_URL=https://<apim>.azure-api.net/responses-ha/openai/v1
# Gateway subscription key (NOT an Azure OpenAI key). Printed by infra/configure_apim.py.
APIM_SUBSCRIPTION_KEY=<apim-subscription-key>
APIM_RESOURCE_ID=/subscriptions/<sub>/resourceGroups/healthmodels/providers/Microsoft.ApiManagement/service/agrag-gateway

# ---- Azure OpenAI (two regions) ----
CHAT_MODEL=gpt-4.1-mini
AOAI_DEPLOYMENT=gpt-4.1-mini
# AIServices (Foundry) endpoints — used by APIM backends + scenarios (audience https://ai.azure.com).
AOAI_PRIMARY_AISVC=https://<primary>.services.ai.azure.com
AOAI_SECONDARY_AISVC=https://<secondary>.services.ai.azure.com
# openai.azure.com Responses v1 endpoints — used by the canary probe + direct scenario load
# (audience https://cognitiveservices.azure.com; the notebook POSTs to {endpoint}/responses).
AOAI_PRIMARY_OPENAI=https://<primary>.openai.azure.com/openai/v1
AOAI_SECONDARY_OPENAI=https://<secondary>.openai.azure.com/openai/v1
AOAI_PRIMARY_RESOURCE_ID=/subscriptions/<sub>/resourceGroups/healthmodels/providers/Microsoft.CognitiveServices/accounts/<primary>
AOAI_SECONDARY_RESOURCE_ID=/subscriptions/<sub>/resourceGroups/healthmodels/providers/Microsoft.CognitiveServices/accounts/<secondary>

# ---- Foundry IQ knowledge base (Azure AI Search) ----
SEARCH_ENDPOINT=https://<search>.search.windows.net
SEARCH_RESOURCE_ID=/subscriptions/<sub>/resourceGroups/healthmodels/providers/Microsoft.Search/searchServices/<search>
KNOWLEDGE_BASE=research-papers-kb
KNOWLEDGE_SOURCE=research-papers-source
EMBEDDING_MODEL=text-embedding-3-large
EMBEDDING_ENDPOINT=https://<primary>.openai.azure.com

# ---- Scholarly-papers MCP server (Azure Container Apps) ----
MCP_URL=https://<mcp-app>.<env>.eastus2.azurecontainerapps.io/mcp
MCP_RESOURCE_ID=/subscriptions/<sub>/resourceGroups/healthmodels/providers/Microsoft.App/containerApps/agrag-scholar-mcp

# ---- Log Analytics (429 throttling signal) ----
LOG_ANALYTICS_WORKSPACE_ID=/subscriptions/<sub>/resourceGroups/healthmodels/providers/Microsoft.OperationalInsights/workspaces/agrag-logs

# ---- Alerts (optional) ----
# Email address for the action group. If set, deploy_health_model.py wires an 'oncall' email
# receiver so Degraded (Sev2) / Unhealthy (Sev1) alerts actually notify. Leave empty for alert-only.
ALERT_EMAIL=
